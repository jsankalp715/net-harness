router ospf
 ospf router-id {{ node.router_id }}
 passive-interface lo
 timers throttle spf {{ node.ospf.spf_delay_ms }} {{ node.ospf.spf_initial_hold_ms }} {{ node.ospf.spf_max_hold_ms }}
 timers throttle lsa all {{ node.ospf.lsa_min_interval_ms }}
 timers lsa min-arrival {{ node.ospf.lsa_min_arrival_ms }}
 log-adjacency-changes
exit
!
